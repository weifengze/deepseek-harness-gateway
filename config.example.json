{
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "maxBodyBytes": 16777216,
    "runTimeoutMs": 300000,
    "streamIdleTimeoutMs": 180000,
    "heartbeatMs": 15000,
    "accessLog": true
  },
  "dsh": {
    "_comment": "A. sidecar：填 baseUrl，令牌用 DSH_API_TOKEN（或 DSH_TOKEN / dsh.tokenFile）。B. 托管：删掉 baseUrl，改用 spawn。",
    "baseUrl": "http://127.0.0.1:3080",
    "tokenFile": "",
    "spawn": {
      "command": "node",
      "args": [
        "/path/to/deepseek-harness/apps/cli/lib/bin.js",
        "--profile",
        "web",
        "--no-open",
        "--port",
        "3080"
      ],
      "cwd": "/path/to/deepseek-harness",
      "startupTimeoutMs": 120000
    }
  },
  "auth": {
    "keys": [
      {
        "id": "demo",
        "secret": "dsh_demo_key_change_me_0001",
        "agents": ["assistant", "rrb-supervisor"],
        "rpm": 60,
        "maxConcurrentRuns": 2,
        "tokenQuota": 0
      }
    ]
  },
  "models": {
    "_comment": "部署级兜底模型。配置后，未声明 agents[].model 的 agent也会在建会话时被显式固定，新会话不再继承 DSH 默认模型的漂移。留空则沿用 DSH 默认（会被任何 selectModel 改写）。",
    "default": { "provider": "deepseek-official", "model": "deepseek-flash", "reasoningEffort": "off" }
  },
  "_agents_comment": "cwd 是会话的工作目录，也是文件下载与沙箱写入的边界，需真实存在且可写。",
  "agents": [
    {
      "id": "assistant",
      "name": "通用助手",
      "description": "standard 预设：日常问答与轻量工具调用。",
      "preset": "standard",
      "cwd": "/path/to/workspaces/assistant"
    },
    {
      "id": "rrb-supervisor",
      "name": "RRB 会议预案总控",
      "description": "rrb-supervisor 预设：需求收集 → 历史检索 → 冲突检查 → 报告输出。",
      "preset": "rrb-supervisor",
      "cwd": "/path/to/workspaces/meeting"
    },
    {
      "id": "rrb-research",
      "name": "RRB 历史检索",
      "description": "rrb-worker-research 预设：RAGFlow 只读检索与证据登记。",
      "preset": "rrb-worker-research",
      "cwd": "/path/to/workspaces/meeting",
      "model": { "provider": "deepseek-official", "model": "deepseek-flash", "reasoningEffort": "high" }
    },
    {
      "id": "harness-dev",
      "name": "Harness 插件开发",
      "description": "cordis 预设：读写 DSH 仓库、生成插件与组合。",
      "preset": "cordis",
      "cwd": "/path/to/deepseek-harness"
    }
  ],
  "limits": {
    "maxConcurrentRuns": 8,
    "maxSessionsPerKey": 200,
    "maxImagesPerRequest": 4,
    "maxImageBytes": 8388608
  },
  "files": {
    "_comment": "产物下载。允许范围 = 每个会话的 cwd + 这里的 roots；不接受整盘/根目录。多实例部署必须显式配置 signingSecret，否则各实例签发的链接互不认。",
    "enabled": true,
    "reader": "auto",
    "roots": [],
    "maxBytes": 33554432,
    "tokenTtlMs": 900000,
    "includeWritten": true
  },
  "storage": {
    "conversationsFile": "data/conversations.json",
    "usageFile": "data/usage.json"
  }
}
