# syntax=docker/dockerfile:1
#
# 形态 A：只跑网关。DSH 在容器外（另一台机器、另一个容器或宿主机）。
# 体积小、启动快，是生产推荐的形态。
#
#   docker build -f docker/Dockerfile.gateway -t dsh-gateway:0.5.0 .
#   docker run -d --name dsh-gateway -p 8787:8787 \
#     -e DSH_BASE_URL=http://192.168.2.198:3080 \
#     -e DSH_TOKEN_FILE=/var/lib/dsh-gateway/dsh-token \
#     -e DSH_GATEWAY_API_KEYS='prod:<至少16位随机串>' \
#     -e DSH_GATEWAY_AGENTS='[{"id":"assistant","preset":"standard","cwd":"/srv/dsh/tenants/acme"}]' \
#     -v /var/lib/dsh-gateway:/var/lib/dsh-gateway:ro \
#     dsh-gateway:0.5.0

ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS build
ARG GATEWAY_VERSION=0.5.0
RUN npm install -g --no-audit --no-fund "deepseek-harness-gateway@${GATEWAY_VERSION}" \
 && npm cache clean --force

FROM ${NODE_IMAGE}
ARG GATEWAY_VERSION=0.5.0

LABEL org.opencontainers.image.title="dsh-api-gateway" \
      org.opencontainers.image.description="HTTP API for DeepSeek Harness (gateway only)" \
      org.opencontainers.image.version="${GATEWAY_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    DSH_BASE_URL=http://127.0.0.1:3080 \
    DSH_TOKEN_FILE=/var/lib/dsh-gateway/dsh-token \
    NODE_OPTIONS=--dns-result-order=ipv4first

COPY --from=build /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -sf /usr/local/lib/node_modules/deepseek-harness-gateway/src/index.mjs /usr/local/bin/dsh-gateway \
 && mkdir -p /var/lib/dsh-gateway \
 && chown -R node:node /var/lib/dsh-gateway

USER node
WORKDIR /home/node

EXPOSE 8787

# 用 node 自己的 fetch，避免为 healthcheck 引入 curl。
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dsh-gateway"]
